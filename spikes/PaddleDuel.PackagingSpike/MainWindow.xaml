<Window
    x:Class="PaddleDuel.PackagingSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Paddle Duel Packaging Spike">
    <StackPanel Padding="32" Spacing="16" Background="Black">
        <TextBlock Text="PACKAGING SPIKE" Foreground="White" FontSize="28" />
        <TextBlock x:Name="PackageIdentity" AutomationProperties.AutomationId="PackageIdentity"
                   Foreground="White" TextWrapping="Wrap" />
        <TextBlock x:Name="RuntimeDetails" AutomationProperties.AutomationId="RuntimeDetails"
                   Foreground="White" TextWrapping="Wrap" />
        <TextBlock Text="TEST IDENTITY ONLY - NOT CONNECTED TO MICROSOFT STORE"
                   Foreground="White" TextWrapping="Wrap" />
        <Button Content="CLOSE" AutomationProperties.AutomationId="CloseSpike" Click="Close_Click" />
    </StackPanel>
</Window>
