<Window
    x:Class="PaddleDuel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Paddle Duel">
    <Grid Background="{StaticResource GameBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="#101010"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">
            <TextBlock x:Uid="TitleBarBrand"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource GameForegroundBrush}" />
            <StackPanel
                x:Name="TitleBarActions"
                Margin="0,4,144,4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button x:Uid="InformationButton"
                    x:Name="InformationButton"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="InformationButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                </Button>
                <Button x:Uid="SettingsButton"
                    x:Name="SettingsButton"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                </Button>
                <Button x:Uid="FullScreenButton"
                    x:Name="FullScreenButton"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FullScreenButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
            <Grid
                x:Name="StartupOverlay"
                Grid.RowSpan="2"
                Canvas.ZIndex="100"
                Background="Black">
                <Image
                    x:Uid="StartupImage"
                    Width="310"
                    Height="150"
                    Source="ms-appx:///Assets/SplashScreen.png"
                    Stretch="Uniform" />
            </Grid>
        </Grid>

        <Grid
            x:Name="GameRoot"
            Grid.Row="1"
            PointerPressed="GameRoot_PointerPressed">
            <Border Margin="32" BorderBrush="{StaticResource GameForegroundBrush}" BorderThickness="2">
                <Canvas x:Name="GameCanvas" SizeChanged="GameCanvas_SizeChanged">
                    <Rectangle x:Name="CenterLine" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="LeftPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="RightPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="Ball" Fill="{StaticResource GameForegroundBrush}" />
                    <TextBlock
                        x:Name="LeftScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                    <TextBlock
                        x:Name="RightScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                </Canvas>
            </Border>

            <Grid
                x:Name="MenuOverlay"
                Background="#E6050505"
                Loaded="MenuOverlay_Loaded">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <TextBlock x:Uid="MenuHeading"
                        x:Name="MenuHeading"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="32"
                        Foreground="{StaticResource GameForegroundBrush}" />
                    <TextBlock x:Uid="KeyboardSummary"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="{StaticResource GameForegroundBrush}" />
                    <StackPanel Height="44" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Uid="QuotaStatusText"
                            x:Name="QuotaStatusText"
                            HorizontalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <TextBlock x:Uid="QuotaResetText"
                            x:Name="QuotaResetText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#B8B8B8" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock x:Uid="AiDifficultyText"
                            x:Name="AiDifficultyText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#B8B8B8" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="EasyDifficultyButton"
                                x:Name="EasyDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                Background="Transparent"
                                BorderBrush="#B8B8B8"
                                BorderThickness="1"
                                Click="EasyDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="{StaticResource GameForegroundBrush}" />
                            <Button x:Uid="MediumDifficultyButton"
                                x:Name="MediumDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                Background="#F4F1E8"
                                BorderThickness="0"
                                Click="MediumDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="#050505" />
                            <Button x:Uid="HardDifficultyButton"
                                x:Name="HardDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                Background="Transparent"
                                BorderBrush="#B8B8B8"
                                BorderThickness="1"
                                Click="HardDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="{StaticResource GameForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Uid="OnePlayerButton"
                        x:Name="OnePlayerButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartOnePlayerButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505" />
                    <Button x:Uid="StartButton"
                        x:Name="StartButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505" />
                    <Button x:Uid="PurchaseEntryButton"
                        x:Name="PurchaseEntryButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="PurchaseEntryButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Button x:Uid="InputSink"
                x:Name="InputSink"
                Width="1"
                Height="1"
                Opacity="0"
                IsTabStop="False"
                KeyDown="InputSink_KeyDown"
                KeyUp="InputSink_KeyUp" />
        </Grid>

        <Grid
            x:Name="InformationOverlay"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Background="#F2050505"
            KeyDown="InformationOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Uid="CloseInformationButton"
                x:Name="CloseInformationButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseInformationButton_Click"
                Foreground="{StaticResource GameForegroundBrush}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="28">
                <TextBlock x:Uid="ControlsHeading"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}" />

                <Grid ColumnSpacing="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14">
                        <TextBlock x:Uid="PlayerOneLabel"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <TextBlock x:Uid="PlayerOneUp"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <TextBlock x:Uid="PlayerOneDown"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <TextBlock x:Uid="PlayerTwoLabel"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <TextBlock x:Uid="PlayerTwoUp"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <TextBlock x:Uid="PlayerTwoDown"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Uid="SinglePlayerControlsHint"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="PurchasePlaceholderOverlay"
            Grid.Row="1"
            Canvas.ZIndex="30"
            Background="#F2050505"
            KeyDown="PurchasePlaceholderOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Uid="ClosePurchasePlaceholderButton"
                x:Name="ClosePurchasePlaceholderButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Click="ClosePurchasePlaceholderButton_Click"
                Foreground="{StaticResource GameForegroundBrush}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">
                <TextBlock x:Uid="StoreHeading"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}" />
                <Grid ColumnSpacing="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock x:Uid="OnePlayProductText"
                            x:Name="OnePlayProductText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <Button x:Uid="BuyOnePlayButton"
                            x:Name="BuyOnePlayButton"
                            Padding="12,8"
                            HorizontalAlignment="Center"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="BuyOnePlayButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505"
                            IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock x:Uid="TenPlayProductText"
                            x:Name="TenPlayProductText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <Button x:Uid="BuyTenPlayButton"
                            x:Name="BuyTenPlayButton"
                            Padding="12,8"
                            HorizontalAlignment="Center"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="BuyTenPlayButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Uid="StorePurchaseStatusText"
                    x:Name="StorePurchaseStatusText"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#B8B8B8"
                    TextAlignment="Center" />
                <TextBlock x:Uid="StoreProductFallbackText"
                    x:Name="StoreProductFallbackText"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="PauseOverlay"
            Grid.Row="1"
            Canvas.ZIndex="25"
            Background="#F2050505"
            KeyDown="PauseOverlay_KeyDown"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">
                <TextBlock x:Uid="PauseHeading"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}" />
                <Button x:Uid="ResumeMatchButton"
                    x:Name="ResumeMatchButton"
                    MinWidth="220"
                    Padding="24,12"
                    HorizontalAlignment="Center"
                    Background="#F4F1E8"
                    BorderThickness="0"
                    Click="ResumeMatchButton_Click"
                    CornerRadius="0"
                    FontFamily="Consolas"
                    Foreground="#050505" />
                <Button x:Uid="AbandonMatchButton"
                    x:Name="AbandonMatchButton"
                    MinWidth="220"
                    Padding="24,12"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{StaticResource GameForegroundBrush}"
                    BorderThickness="1"
                    Click="AbandonMatchButton_Click"
                    CornerRadius="0"
                    FontFamily="Consolas"
                    Foreground="{StaticResource GameForegroundBrush}" />
                <TextBlock x:Uid="AbandonHint"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#B8B8B8" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="SettingsOverlay"
            Grid.Row="1"
            Canvas.ZIndex="35"
            Background="#F2050505"
            KeyDown="SettingsOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Uid="CloseSettingsButton"
                x:Name="CloseSettingsButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseSettingsButton_Click"
                Foreground="{StaticResource GameForegroundBrush}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="26">
                <TextBlock x:Uid="SettingsHeading"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}" />
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock x:Uid="SettingsAiDifficultyText"
                        x:Name="SettingsAiDifficultyText"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#B8B8B8" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <Button x:Uid="SettingsEasyDifficultyButton"
                            x:Name="SettingsEasyDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsEasyDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}" />
                        <Button x:Uid="SettingsMediumDifficultyButton"
                            x:Name="SettingsMediumDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="SettingsMediumDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505" />
                        <Button x:Uid="SettingsHardDifficultyButton"
                            x:Name="SettingsHardDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsHardDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock x:Uid="SettingsDisplayModeText"
                        x:Name="SettingsDisplayModeText"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#B8B8B8" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsWindowedButton"
                            x:Name="SettingsWindowedButton"
                            Width="150"
                            Padding="12,8"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="SettingsWindowedButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505" />
                        <Button x:Uid="SettingsFullScreenButton"
                            x:Name="SettingsFullScreenButton"
                            Width="150"
                            Padding="12,8"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsFullScreenButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>