<Window
    x:Class="Arcade1972.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="1972 Arcade">
    <Grid Background="{StaticResource GameBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="#101010"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource GameForegroundBrush}"
                Text="1972 ARCADE" />
            <StackPanel
                x:Name="TitleBarActions"
                Margin="0,4,144,4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="InformationButton"
                    Padding="10,0"
                    AutomationProperties.Name="Show controls"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="InformationButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}"
                    ToolTipService.ToolTip="Controls">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Padding="10,0"
                    AutomationProperties.Name="Show settings"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="FullScreenButton"
                    Padding="10,0"
                    AutomationProperties.Name="Toggle full screen"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FullScreenButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}"
                    ToolTipService.ToolTip="Full screen">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="GameRoot"
            Grid.Row="1"
            PointerPressed="GameRoot_PointerPressed">
            <Border Margin="32" BorderBrush="{StaticResource GameForegroundBrush}" BorderThickness="2">
                <Canvas x:Name="GameCanvas" SizeChanged="GameCanvas_SizeChanged">
                    <Rectangle x:Name="CenterLine" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="LeftPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="RightPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="Ball" Fill="{StaticResource GameForegroundBrush}" />
                    <TextBlock
                        x:Name="LeftScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                    <TextBlock
                        x:Name="RightScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                </Canvas>
            </Border>

            <Grid
                x:Name="MenuOverlay"
                Background="#E6050505"
                Loaded="MenuOverlay_Loaded">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <TextBlock
                        x:Name="MenuHeading"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="32"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="1972 ARCADE" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="W / S        UP / DOWN" />
                    <StackPanel Height="44" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            x:Name="QuotaStatusText"
                            HorizontalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="FREE PLAYS  -- / --" />
                        <TextBlock
                            x:Name="QuotaResetText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#B8B8B8"
                            Text="RESET  ---- -- --  00:00 UTC" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            x:Name="AiDifficultyText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#B8B8B8"
                            Text="AI DIFFICULTY  MEDIUM" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="EasyDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                AutomationProperties.Name="Set AI difficulty easy"
                                Background="Transparent"
                                BorderBrush="#B8B8B8"
                                BorderThickness="1"
                                Click="EasyDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="{StaticResource GameForegroundBrush}"
                                Content="EASY" />
                            <Button
                                x:Name="MediumDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                AutomationProperties.Name="Set AI difficulty medium"
                                Background="#F4F1E8"
                                BorderThickness="0"
                                Click="MediumDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="#050505"
                                Content="MEDIUM" />
                            <Button
                                x:Name="HardDifficultyButton"
                                Width="90"
                                Padding="8,6"
                                AutomationProperties.Name="Set AI difficulty hard"
                                Background="Transparent"
                                BorderBrush="#B8B8B8"
                                BorderThickness="1"
                                Click="HardDifficultyButton_Click"
                                CornerRadius="0"
                                FontFamily="Consolas"
                                Foreground="{StaticResource GameForegroundBrush}"
                                Content="HARD" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        x:Name="OnePlayerButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Start one player match"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartOnePlayerButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Content="ONE PLAYER" />
                    <Button
                        x:Name="StartButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Start local two player match"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Content="TWO PLAYERS" />
                    <Button
                        x:Name="PurchaseEntryButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Get more plays"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="PurchaseEntryButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Content="GET PLAYS"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Button
                x:Name="InputSink"
                Width="1"
                Height="1"
                Opacity="0"
                AutomationProperties.Name="Internal game keyboard input"
                IsTabStop="False"
                KeyDown="InputSink_KeyDown"
                KeyUp="InputSink_KeyUp" />
        </Grid>

        <Grid
            x:Name="InformationOverlay"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Background="#F2050505"
            KeyDown="InformationOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="CloseInformationButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close controls"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseInformationButton_Click"
                Foreground="{StaticResource GameForegroundBrush}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="28">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Text="CONTROLS" />

                <Grid ColumnSpacing="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="PLAYER 1" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="W   MOVE UP" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="S   MOVE DOWN" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="PLAYER 2" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="UP ARROW     MOVE UP" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="DOWN ARROW   MOVE DOWN" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    Text="ONE PLAYER MODE USES PLAYER 1 CONTROLS"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="PurchasePlaceholderOverlay"
            Grid.Row="1"
            Canvas.ZIndex="30"
            Background="#F2050505"
            KeyDown="PurchasePlaceholderOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="ClosePurchasePlaceholderButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close Store placeholder"
                Background="Transparent"
                BorderThickness="0"
                Click="ClosePurchasePlaceholderButton_Click"
                Foreground="{StaticResource GameForegroundBrush}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Text="MORE PLAYS" />
                <Grid ColumnSpacing="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="18"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="1 PLAY" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="18"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="10 PLAYS" />
                </Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    Text="MICROSOFT STORE IS NOT CONNECTED"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="PauseOverlay"
            Grid.Row="1"
            Canvas.ZIndex="25"
            Background="#F2050505"
            KeyDown="PauseOverlay_KeyDown"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Text="PAUSED" />
                <Button
                    x:Name="ResumeMatchButton"
                    MinWidth="220"
                    Padding="24,12"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Resume match"
                    Background="#F4F1E8"
                    BorderThickness="0"
                    Click="ResumeMatchButton_Click"
                    CornerRadius="0"
                    FontFamily="Consolas"
                    Foreground="#050505"
                    Content="CONTINUE" />
                <Button
                    x:Name="AbandonMatchButton"
                    MinWidth="220"
                    Padding="24,12"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Abandon match and return to menu"
                    Background="Transparent"
                    BorderBrush="{StaticResource GameForegroundBrush}"
                    BorderThickness="1"
                    Click="AbandonMatchButton_Click"
                    CornerRadius="0"
                    FontFamily="Consolas"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Content="ABANDON MATCH" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#B8B8B8"
                    Text="RETURNING TO MENU WILL NOT USE A PLAY" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="SettingsOverlay"
            Grid.Row="1"
            Canvas.ZIndex="35"
            Background="#F2050505"
            KeyDown="SettingsOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="CloseSettingsButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close settings"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseSettingsButton_Click"
                Foreground="{StaticResource GameForegroundBrush}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="26">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Text="SETTINGS" />
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock
                        x:Name="SettingsAiDifficultyText"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#B8B8B8"
                        Text="AI DIFFICULTY  MEDIUM" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <Button
                            x:Name="SettingsEasyDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            AutomationProperties.Name="Set settings AI difficulty easy"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsEasyDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Content="EASY" />
                        <Button
                            x:Name="SettingsMediumDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            AutomationProperties.Name="Set settings AI difficulty medium"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="SettingsMediumDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505"
                            Content="MEDIUM" />
                        <Button
                            x:Name="SettingsHardDifficultyButton"
                            Width="90"
                            Padding="8,6"
                            AutomationProperties.Name="Set settings AI difficulty hard"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsHardDifficultyButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Content="HARD" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock
                        x:Name="SettingsDisplayModeText"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#B8B8B8"
                        Text="DISPLAY  WINDOWED" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SettingsWindowedButton"
                            Width="150"
                            Padding="12,8"
                            AutomationProperties.Name="Use windowed display mode"
                            Background="#F4F1E8"
                            BorderThickness="0"
                            Click="SettingsWindowedButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="#050505"
                            Content="WINDOWED" />
                        <Button
                            x:Name="SettingsFullScreenButton"
                            Width="150"
                            Padding="12,8"
                            AutomationProperties.Name="Use full screen display mode"
                            Background="Transparent"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Click="SettingsFullScreenButton_Click"
                            CornerRadius="0"
                            FontFamily="Consolas"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Content="FULL SCREEN" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>